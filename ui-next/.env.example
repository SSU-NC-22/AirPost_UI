# AirPost UI environment configuration. Copy to `.env` and adjust as needed.

# Application REST API base URL.
VITE_API_BASE=http://localhost:8081

# Health-check WebSocket base URL (the client appends /health-check).
VITE_WS_BASE=ws://localhost:8085

# Set to "true" to use src/data/mock.ts instead of the backend.
VITE_USE_MOCK=false
